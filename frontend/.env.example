# ── Frontend Environment ──
# These are auto-configured by the Vite dev server proxy.
# You do NOT need to create a .env file for local development.
# Just run: npm run dev
#
# The vite proxy forwards API calls to the production server automatically.
# Override these only if you're running your own local chain.

VITE_JSON_RPC_URL=/evm-rpc
VITE_CHAIN_ID=728643862094908
VITE_FAUCET_URL=/faucet
VITE_COSMOS_RPC_URL=/cosmos-rpc
VITE_COSMOS_REST_URL=/cosmos-rest
VITE_COSMOS_CHAIN_ID=signalmarket
