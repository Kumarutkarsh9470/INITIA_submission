# ── Backend / Contract Deployment ──
# Only needed if deploying or redeploying contracts.
# Frontend-only contributors do NOT need this file.

# EVM RPC endpoint of your MiniEVM chain
MINIEVM_RPC_URL=http://localhost:8545

# Deployer private key (hex, with 0x prefix)
# WARNING: Never commit actual keys. This file is a template only.
PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY_HERE

# EVM chain ID (default: Contabo production chain)
MINIEVM_CHAIN_ID=728643862094908
